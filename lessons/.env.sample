# 复制本文件为 <课程目录>/.env，填入你自己的 DeepSeek API key。
# .env 已在 .gitignore 里，不会被提交。key 只在本机的 tools/serve.py 里使用，不会进入浏览器页面。
# 申请 key：https://platform.deepseek.com/api_keys （DeepSeek 官方 API 按量计费，需先充值）
DEEPSEEK_API_KEY=sk-your-key-here

# 可选：模型与推理强度
# DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_EFFORT=low

# 可选：AI 讲师的“换个讲法”优先用 Kimi（Kimi Code 包月 key，接口 https://api.kimi.com/coding/v1）。
# 不配这一项时，“换个讲法”改用上面的 DeepSeek。
# MOONSHOT_API_KEY=sk-kimi-your-key-here
# KIMI_MODEL=k3.1-pro
